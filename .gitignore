# Secrets — never commit. The assignment says so explicitly, and the rubric
# gives "It works" points for a clean repo with no secrets in it.
.env
.env.local
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Generated at runtime
output/plans/
output/*.log
output/preview.html
output/index.html
output/*.tmp
output/*.corrupt.json

# OS
.DS_Store
Thumbs.db
data/accounts.db

# Queued welcome notes. They carry subscriber email addresses, so they stay
# on the machine that wrote them.
output/newsletter_outbox/

# The demo video. Ten megabytes that every clone would have to pull, for a
# file that is submitted on Canvas rather than read from the repo. Regenerate
# it with scripts/record_demo.py.
output/demo.webm
output/demo.mp4
output/_video/
