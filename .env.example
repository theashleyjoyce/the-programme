# The Programme — example environment file.
# Copy to .env and fill in. NEVER commit a real .env.
#
# The app looks for .env in TWO places, in this order:
#   1. this repo's own folder
#   2. the folder one level above it   <-- where the teaching staff's .env sits
# Both are loaded, and the repo's own file wins where they overlap, so a local
# .env can override one setting without restating the keys.

# --- credentials: one of these two is required ---------------------------
# Course key. Preferred when present: it costs the student nothing.
PORTKEY_API_KEY=

# Personal OpenAI key. Used automatically if the course key is absent, and as
# a fallback if the course key is rejected.
OPENAI_API_KEY=

# --- optional ------------------------------------------------------------
# Force a provider instead of preferring the course key: openai | portkey
# MODEL_PROVIDER=

# Hard spending cap in USD, enforced in code against a persistent ledger at
# output/spend_ledger.json. The app refuses a call rather than passing this.
BUDGET_USD=10.00

# Most model calls one single plan may make, so a retry loop cannot drain the
# budget on one request. The pipeline normally uses two.
MAX_CALLS_PER_RUN=6

# Token prices in USD per million, for the tokenomics figures. VERIFY these
# against the provider's pricing page before quoting them in the report.
# PRICE_INPUT_PER_M=1.25
# PRICE_CACHED_PER_M=0.125
# PRICE_OUTPUT_PER_M=10.00
# PRICING_VERIFIED=false
